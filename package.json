{
  "name": "final-task",
  "version": "1.0.0",
  "description": "",
  "main": "js/script.js",
  "scripts": {
    "build:js": "echo 'Budowanie JS...'",
    "build:css": "echo 'Budowanie CSS...'",
    "build:assets": "echo 'Kopiowanie plików...'",
    "build:sass": "sass --style=compressed --no-source-map sass/style.scss:css/style.css",
    "build:autoprefixer": "postcss css/*.css --use autoprefixer -d css",
    "build": "npm-run-all build:sass build:autoprefixer build:js build:css build:assets",
    "build:dev-sass": "sass --style=expanded --source-map sass/style.scss:css/style.css",
    "build:dev": "npm run build:dev-sass",
    "watch:sass": "sass --watch --style=expanded --source-map sass/style.scss:css/style.css",
    "watch": "npm-run-all -p watch:sass",
    "init-project": "npm install && npm-run-all init:*",
    "init:dirs": "mkdirp sass css vendor images js",
    "init:files": "touch Readme.md index.html sass/style.scss js/script.js",
    "init:gitignore": "curl https://raw.githubusercontent.com/github/gitignore/master/Node.gitignore -o .gitignore",
    "test": "npm run test:html",
    "test:html": "html-validate *.html"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mdev122/final-task.git"
  },
  "bugs": {
    "url": "https://github.com/Mdev122/final-task/issues"
  },
  "homepage": "https://github.com/Mdev122/final-task#readme",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "npm-run-all": "^4.1.5",
    "sass": "^1.70.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.2.4",
    "html-validate": "^11.2.0",
    "mkdirp": "^3.0.1",
    "postcss": "^8.2.6",
    "postcss-cli": "^8.3.1"
  }
}